rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 👇 NOVA REGRA ADICIONADA: Permissão para o sistema de Chats
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.users;
      
      match /messages/{messageId} {
        allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
        allow read: if request.auth != null && (
          ('users' in resource.data && request.auth.uid in resource.data.users) ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users
        );
        allow update, delete: if false;
      }
    }
    
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
      
      // Permite que o autor edite seu post, ou que outros usuários apenas alterem os contadores de likes/comentários.
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
          && (request.resource.data.likesCount == resource.data.likesCount + 1 || request.resource.data.likesCount == resource.data.likesCount - 1 || request.resource.data.likesCount == resource.data.likesCount)
          && (request.resource.data.commentsCount == resource.data.commentsCount + 1 || request.resource.data.commentsCount == resource.data.commentsCount - 1 || request.resource.data.commentsCount == resource.data.commentsCount)
        )
      );
      
      // Mantemos o 'delete' restrito: apenas o dono pode apagar o próprio post
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      
      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null
            && request.auth.uid == userId;
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
            && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null
            && resource.data.authorId == request.auth.uid;
      }
    }
    
    // Usuários podem ler perfis, mas não devem armazenar e-mail em documentos públicos
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
          && (!('email' in request.resource.data) || request.resource.data.email == null);
      
      // Permissão para a subcoleção privada (onde salvamos o e-mail)
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Exceção para as Notificações
      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
            && request.auth.uid == request.resource.data.senderId;
      }
      
      // Permissão para a Estante de Livros (library)
      match /library/{bookId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Sistema de seguir/bloquear
    match /followGraph/{docId} {
      // As checagens de followGraph podem consultar um documento inexistente para saber se existe seguimento.
      // Autenticados podem ler esses documentos para que o app trate usuários privados corretamente.
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.followerId == request.auth.uid
          && request.resource.data.followedId != request.auth.uid
          && request.resource.data.followerId is string
          && request.resource.data.followedId is string;
      allow update: if request.auth != null
          && request.auth.uid in [resource.data.followerId, resource.data.followedId];
      allow delete: if request.auth != null
          && request.auth.uid == resource.data.followerId;
    }
    match /userBlocks/{docId} {
      allow read: if request.auth != null
          && request.auth.uid in [resource.data.blockerId, resource.data.blockedId];
      allow create: if request.auth != null
          && request.resource.data.blockerId == request.auth.uid
          && request.resource.data.blockedId != request.auth.uid
          && request.resource.data.blockerId is string
          && request.resource.data.blockedId is string;
      allow delete: if request.auth != null
          && request.auth.uid == resource.data.blockerId;
      allow update: if false;
    }
    
    // Biblioteca de livros dos usuários
    match /userBooks/{userId}/library/{bookId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Denúncias
    match /contentReports/{docId} {
      allow create: if request.auth != null
          && request.auth.uid == request.resource.data.reporterId
          && request.resource.data.reporterId != request.resource.data.targetId;
      allow read: if false;
    }
  }
}
