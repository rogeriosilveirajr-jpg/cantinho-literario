rules_version = '2';

// ============================================================
//  CANTINHO LITERÁRIO — Regras de segurança do Firestore
//
//  Importante: regras não funcionam como filtro. Uma busca só é aceita
//  se as regras permitirem TODOS os documentos que ela pode trazer.
//  Por isso o feed busca só posts com isPrivate == false, e o perfil
//  de quem a pessoa não segue também filtra isPrivate == false.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(me()));
    }

    // Logado e não bloqueado pela moderação (bannedUsers/{uid}). Exigido em toda gravação de conteúdo:
    // quem foi bloqueado continua lendo, mas não publica, comenta, curte, segue nem conversa.
    function active() {
      return signedIn() && !exists(/databases/$(database)/documents/bannedUsers/$(me()));
    }

    function isPrivateUser(userId) {
      let ref = /databases/$(database)/documents/users/$(userId);
      return exists(ref) && get(ref).data.get('isPrivate', false) == true;
    }

    function followAccepted(followerId, followedId) {
      let ref = /databases/$(database)/documents/followGraph/$(followerId + '_' + followedId);
      return exists(ref) && get(ref).data.status == 'ACCEPTED';
    }

    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/userBlocks/$(a + '_' + b))
          || exists(/databases/$(database)/documents/userBlocks/$(b + '_' + a));
    }

    // Pode ver o conteúdo (posts, estante) de ownerId?
    function canSeeUser(ownerId) {
      return ownerId == me() || !isPrivateUser(ownerId) || followAccepted(me(), ownerId);
    }

    // Pode ver um post? Usa o campo isPrivate do próprio post (mantido em sincronia pelo app).
    function canSeePost(post) {
      return post.authorId == me()
          || post.get('isPrivate', false) == false
          || followAccepted(me(), post.authorId);
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function stepOfOne(field) {
      let before = resource.data.get(field, 0);
      let after = request.resource.data.get(field, 0);
      return after == before + 1 || after == before - 1;
    }

    // Ids que o app coloca em atributos HTML: só letras, números, _ e -. Impede que um id
    // malicioso vire código (XSS) na tela de outra pessoa.
    function safeId(s) { return s is string && s.matches('^[A-Za-z0-9_-]{1,64}$'); }
    function autoId(s) { return s.matches('^[A-Za-z0-9]{20}$'); }   // formato dos ids gerados pelo Firestore

    function validBook(b) {
      return b == null || (b is map
          && b.keys().hasOnly(['id', 'title', 'author', 'coverUrl'])
          && safeId(b.id)
          && b.get('title', '') is string && b.get('title', '').size() <= 300
          && b.get('author', '') is string && b.get('author', '').size() <= 300
          && b.get('coverUrl', '') is string && b.get('coverUrl', '').size() <= 500);
    }

    // Campos dos recursos de leitor: tipo do post, nota do livro, spoiler e status da troca.
    function validPostFields(d) {
      return d.get('postType', 'normal') in ['normal', 'trade', 'quote']
          && d.get('rating', 0) is int && d.get('rating', 0) >= 0 && d.get('rating', 0) <= 5
          && d.get('hasSpoiler', false) is bool
          && d.get('text', '') is string && d.get('text', '').size() <= 2000
          && d.get('tradeStatus', null) in [null, 'AVAILABLE', 'RESERVED', 'DONE']
          && (d.get('bookId', null) == null || safeId(d.bookId))
          && validBook(d.get('book', null))
          && d.get('location', '') is string && d.get('location', '').size() <= 100;
    }

    // ---------- administradores (moderação) ----------
    // Para tornar alguém moderador, crie à mão no console do Firebase o documento admins/{uid}.
    match /admins/{userId} {
      allow read: if signedIn() && userId == me();
      allow write: if false;
    }

    // Usuários bloqueados pela moderação. Só moderadores gravam; a própria pessoa lê o aviso.
    // Moderador não bloqueia a si mesmo nem outro moderador.
    match /bannedUsers/{userId} {
      allow read: if signedIn() && (userId == me() || isAdmin());
      allow create, update: if isAdmin()
          && userId != me()
          && !exists(/databases/$(database)/documents/admins/$(userId))
          && request.resource.data.keys().hasOnly(['reason', 'bannedBy', 'bannedAt'])
          && request.resource.data.bannedBy == me()
          && request.resource.data.reason is string
          && request.resource.data.reason.size() <= 300;
      allow delete: if isAdmin();
    }

    // Posts ocultados pela moderação. Ocultar = copiar o post para cá, sem mudar nada, e apagar
    // o original na mesma gravação. Restaurar faz o caminho inverso (ver a regra de create dos posts).
    match /moderatedPosts/{postId} {
      function postPath() { return /databases/$(database)/documents/posts/$(postId); }

      allow read, delete: if isAdmin();
      allow create: if isAdmin()
          && exists(postPath())
          && !existsAfter(postPath())
          && request.resource.data.keys().hasOnly(['post', 'hiddenBy', 'hiddenAt', 'reason'])
          && request.resource.data.post == get(postPath()).data
          && request.resource.data.hiddenBy == me()
          && request.resource.data.get('reason', '') is string
          && request.resource.data.get('reason', '').size() <= 300;
      allow update: if false;
    }

    // ---------- usuários ----------
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == me()
          && (!('email' in request.resource.data) || request.resource.data.email == null)
          && request.resource.data.get('followersCount', 0) == 0;
      allow update: if active() && (
          // o próprio usuário edita o perfil (sem gravar e-mail no documento público)
          (userId == me() && (!('email' in request.resource.data) || request.resource.data.email == null)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['followersCount']))
          // outra pessoa só pode somar/subtrair 1 no contador de seguidores
          || (userId != me() && changesOnly(['followersCount']) && stepOfOne('followersCount'))
        );
      allow delete: if signedIn() && userId == me();

      match /private/{docId} {
        allow read, write: if signedIn() && userId == me();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if signedIn() && userId == me();
        allow create: if active()
            && request.resource.data.senderId == me()
            && userId != me()
            && !blockedBetween(me(), userId);
      }

      match /library/{bookId} {
        allow read: if signedIn() && canSeeUser(userId);
        allow write: if active() && userId == me() && safeId(bookId);
      }
    }

    match /userBooks/{userId}/library/{bookId} {
      allow read: if signedIn() && canSeeUser(userId);
      allow write: if active() && userId == me();
    }

    // ---------- posts ----------
    match /posts/{postId} {
      // Moderadores também leem, para analisar denúncias de posts privados.
      allow get: if signedIn() && (canSeePost(resource.data) || isAdmin());
      // Buscas (list) precisam de condições que o motor de regras consiga provar pela própria busca.
      // Não use .get('isPrivate', false) aqui: com valor padrão o motor aceitava QUALQUER busca e
      // devolvia posts privados de quem a pessoa não segue (falha de privacidade corrigida em 31/10/2026).
      allow list: if signedIn() && (
          resource.data.isPrivate == false
          || resource.data.authorId == me()
          || followAccepted(me(), resource.data.authorId)
          || isAdmin());
      allow create: if (active()
          && autoId(postId)
          && request.resource.data.authorId == me()
          && request.resource.data.isPrivate is bool
          && validPostFields(request.resource.data)
          && request.resource.data.get('tradeStatus', null) in [null, 'AVAILABLE'])
        // moderador restaura um post ocultado exatamente como era, apagando a cópia na mesma gravação
        || (isAdmin()
          && exists(/databases/$(database)/documents/moderatedPosts/$(postId))
          && !existsAfter(/databases/$(database)/documents/moderatedPosts/$(postId))
          && request.resource.data == get(/databases/$(database)/documents/moderatedPosts/$(postId)).data.post);
      allow update: if active() && (
          // o autor edita o post (sem trocar o autor); troca concluída não volta atrás
          (resource.data.authorId == me() && request.resource.data.authorId == me()
            && validPostFields(request.resource.data)
            && !(resource.data.get('tradeStatus', null) == 'DONE' && request.resource.data.get('tradeStatus', null) != 'DONE'))
          // quem pode ver o post só altera os contadores, de 1 em 1
          || (canSeePost(resource.data) && changesOnly(['likesCount']) && stepOfOne('likesCount'))
          || (canSeePost(resource.data) && changesOnly(['commentsCount']) && stepOfOne('commentsCount'))
        );
      allow delete: if signedIn() && (resource.data.authorId == me() || isAdmin());

      function parentPost() { return get(/databases/$(database)/documents/posts/$(postId)).data; }

      match /likes/{userId} {
        allow read: if signedIn() && canSeePost(parentPost());
        allow create: if active() && userId == me()
            && request.resource.data.userId == me()
            && canSeePost(parentPost());
        allow delete: if signedIn() && userId == me();
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn() && canSeePost(parentPost());
        allow create: if active()
            && request.resource.data.authorId == me()
            && canSeePost(parentPost())
            && !blockedBetween(me(), parentPost().authorId);
        allow update: if active() && resource.data.authorId == me();
        allow delete: if signedIn() && (resource.data.authorId == me() || isAdmin());
      }
    }

    // Busca dos próprios comentários em todos os posts (usada ao excluir a conta).
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.authorId == me();
    }

    // ---------- seguir ----------
    match /followGraph/{followId} {
      allow read: if signedIn();

      // Quem segue cria o pedido. Perfil privado só aceita pedido PENDENTE.
      allow create: if active()
          && request.resource.data.followerId == me()
          && request.resource.data.followedId is string
          && request.resource.data.followedId != me()
          && followId == me() + '_' + request.resource.data.followedId
          && !blockedBetween(me(), request.resource.data.followedId)
          && (
            request.resource.data.status == 'PENDING'
            || (request.resource.data.status == 'ACCEPTED' && !isPrivateUser(request.resource.data.followedId))
          );

      // Só quem recebeu o pedido pode aceitá-lo (PENDENTE → ACEITO).
      allow update: if active()
          && resource.data.followedId == me()
          && resource.data.status == 'PENDING'
          && request.resource.data.status == 'ACCEPTED'
          && changesOnly(['status', 'updatedAt']);

      // Quem segue pode deixar de seguir; quem é seguido pode recusar ou remover o seguidor.
      allow delete: if signedIn()
          && me() in [resource.data.followerId, resource.data.followedId];
    }

    // ---------- bloqueios ----------
    match /userBlocks/{blockId} {
      allow read: if signedIn() && me() in [resource.data.blockerId, resource.data.blockedId];
      allow create: if signedIn()
          && request.resource.data.blockerId == me()
          && request.resource.data.blockedId is string
          && request.resource.data.blockedId != me()
          && blockId == me() + '_' + request.resource.data.blockedId;
      allow delete: if signedIn() && resource.data.blockerId == me();
      allow update: if false;
    }

    // ---------- chat ----------
    // Conversa só entre duas pessoas que se seguem (em qualquer direção) e sem bloqueio entre elas.
    match /chats/{chatId} {
      function members() { return get(/databases/$(database)/documents/chats/$(chatId)).data.users; }

      // resource == null: o app confere se a conversa já existe antes de criá-la.
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if active()
          && request.resource.data.users is list
          && request.resource.data.users.size() == 2
          && me() in request.resource.data.users
          && (chatId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
              || chatId == request.resource.data.users[1] + '_' + request.resource.data.users[0])
          && !blockedBetween(request.resource.data.users[0], request.resource.data.users[1])
          && (followAccepted(request.resource.data.users[0], request.resource.data.users[1])
              || followAccepted(request.resource.data.users[1], request.resource.data.users[0]));
      allow update: if active()
          && me() in resource.data.users
          && request.resource.data.users == resource.data.users
          && !blockedBetween(resource.data.users[0], resource.data.users[1]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && me() in members();
        allow create: if active()
            && me() in members()
            && request.resource.data.senderId == me()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && !blockedBetween(members()[0], members()[1]);
        allow update, delete: if false;
      }
    }

    // ---------- clubes do livro ----------
    match /clubs/{clubId} {
      function clubPath() { return /databases/$(database)/documents/clubs/$(clubId); }
      function memberPath(uid) { return /databases/$(database)/documents/clubs/$(clubId)/members/$(uid); }
      function validClub(d) {
        return d.name is string && d.name.size() >= 3 && d.name.size() <= 60
            && d.get('description', '') is string && d.get('description', '').size() <= 300
            && d.get('city', '') is string && d.get('city', '').size() <= 60;
      }

      allow read: if signedIn();
      // Quem cria já entra como primeiro membro, na mesma gravação.
      allow create: if active()
          && autoId(clubId)
          && request.resource.data.ownerId == me()
          && request.resource.data.membersCount == 1
          && validBook(request.resource.data.get('bookOfMonth', null))
          && validClub(request.resource.data)
          && existsAfter(memberPath(me()));
      allow update: if active() && (
          // o dono muda os dados e o livro do mês, nunca o dono nem o contador
          (resource.data.ownerId == me()
            && changesOnly(['name', 'description', 'city', 'cityKey', 'bookOfMonth'])
            && validClub(request.resource.data)
            && validBook(request.resource.data.get('bookOfMonth', null)))
          // o contador só sobe junto com a entrada da pessoa e só desce junto com a saída
          || (changesOnly(['membersCount'])
            && request.resource.data.membersCount == resource.data.membersCount + 1
            && !exists(memberPath(me())) && existsAfter(memberPath(me())))
          || (changesOnly(['membersCount'])
            && request.resource.data.membersCount == resource.data.membersCount - 1
            && exists(memberPath(me())) && !existsAfter(memberPath(me())))
        );
      allow delete: if signedIn() && resource.data.ownerId == me();

      match /members/{uid} {
        allow read: if signedIn();
        // Entrar e sair sempre acompanham o contador do clube (ou a criação do clube).
        allow create: if active() && uid == me()
            && request.resource.data.uid == me()
            && (!exists(clubPath())
                || getAfter(clubPath()).data.membersCount == get(clubPath()).data.membersCount + 1);
        // O dono não sai do próprio clube (para o clube não ficar sem dono).
        allow delete: if signedIn() && uid == me()
            && get(clubPath()).data.ownerId != me()
            && getAfter(clubPath()).data.membersCount == get(clubPath()).data.membersCount - 1;
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && exists(memberPath(me()));
        allow create: if active()
            && exists(memberPath(me()))
            && request.resource.data.senderId == me()
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000
            && request.resource.data.get('senderName', '') is string
            && request.resource.data.get('senderName', '').size() <= 100;
        allow delete: if signedIn() && resource.data.senderId == me();
        allow update: if false;
      }
    }

    // ---------- denúncias ----------
    match /contentReports/{reportId} {
      allow create: if active()
          && request.resource.data.reporterId == me()
          && request.resource.data.reporterId != request.resource.data.targetId
          && safeId(request.resource.data.targetId)
          && request.resource.data.status == 'PENDING';
      allow read, update: if isAdmin();
      allow delete: if false;
    }
  }
}
